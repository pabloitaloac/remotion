{
  "name": "@pabloitaloac/remotion-studio",
  "version": "1.0.0",
  "description": "Reusable Remotion studio for project showcase videos.",
  "repository": {
    "type": "git",
    "url": "https://github.com/pabloitaloac/remotion.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.484",
    "@remotion/tailwind-v4": "4.0.484",
    "tailwindcss": "4.0.0",
    "execa": "9.6.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.484",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render:project": "node scripts/render-project.mjs",
